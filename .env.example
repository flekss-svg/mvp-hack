# Для docker compose: скопируйте в .env (рядом с compose.yaml) и вставьте ключ. .env не коммитится.
# Ключ JavaScript API Яндекс.Карт; Vite вшивает его в дашборд при сборке образа web.
VITE_YANDEX_MAPS_API_KEY=

# Сдвиг времени GPS/Unix относительно шкалы расписания, секунды (0 = расписание в UTC).
NDTP_PLAN_TZ_OFFSET_S=0
