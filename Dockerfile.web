# Дашборд: сборка Vite на Node 20, раздача nginx. /api, /docs, /openapi.json nginx проксирует в backend.
FROM node:20-alpine AS build

WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./

# Vite вшивает ключ в JS при сборке. Передается build-arg'ом из .env в корне (см. compose.yaml).
# web/.env в сборку не попадает (.dockerignore), чтобы ключ шел только отсюда.
ARG VITE_YANDEX_MAPS_API_KEY=""
ENV VITE_YANDEX_MAPS_API_KEY=${VITE_YANDEX_MAPS_API_KEY}
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/web/dist /usr/share/nginx/html

EXPOSE 80
